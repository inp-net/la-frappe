        "@sveltejs/kit": "^2.70.3",
        "@sveltejs/vite-plugin-svelte": "^6.2.4",
        "@types/node": "^25.9.9",
        "@types/nodemailer": "^8.0.2",
        "prettier": "^3.9.10",
        "prettier-plugin-svelte": "^3.5.2",
        "svelte": "^5.57.2",
        "svelte-check": "^4.7.6",
        "typescript": "^5.9.3",
        "vite": "^7.3.7"
    },
    "dependencies": {
        "@auth/sveltekit": "^1.11.3",
        "@lucide/svelte": "^1.55.0",
        "auth": "^1.7.7",
        "azucar-ui": "^0.0.9",
