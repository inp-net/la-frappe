		"@types/node": "^25.5.2",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.4.1",
		"svelte": "^5.54.0",
		"svelte-check": "^4.4.2",
		"typescript": "^5.9.3",
		"vite": "^7.3.1"
	},
	"dependencies": {
		"@auth/sveltekit": "^1.11.2",
		"@lucide/svelte": "^1.20.0",
		"auth": "^1.6.20",
		"azucar-ui": "^0.0.7",
		"svelte-sonner": "^1.1.1"
