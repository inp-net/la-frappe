{
    "extends": "./.svelte-kit/tsconfig.json",
    "compilerOptions": {
        "sourceMap": true,
        "strict": true,
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "skipLibCheck": true
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.js",
        "src/**/*.svelte",
        ".svelte-kit/ambient.d.ts",
        ".svelte-kit/types/*"
    ]
}
